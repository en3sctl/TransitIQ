{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      { "include": "tickets/fonts/*.ttf", "outDir": "dist/src" },
      { "include": "tickets/assets/*.png", "outDir": "dist/src" },
      { "include": "notifications/templates/*.png", "outDir": "dist/src" }
    ],
    "watchAssets": true
  }
}
