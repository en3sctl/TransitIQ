// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  COMPANY_ADMIN
  OPERATOR
  DRIVER
  PASSENGER
}

enum VehicleStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

enum SeatType {
  STANDARD
  VIP
}

enum SeatStatus {
  AVAILABLE
  BLOCKED
  BOOKED
  LOCKED
}

enum TripStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  NO_SHOW
}

enum BoardingStatus {
  PENDING
  BOARDED
  NO_SHOW
}

model Tenant {
  id        String    @id @default(uuid())
  name      String
  domain    String?   @unique
  slug      String    @unique
  status    String    @default("ACTIVE")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  users     User[]
  vehicles  Vehicle[]
  stations  Station[]
  routes    Route[]
  trips     Trip[]
  bookings  Booking[]
  auditLogs AuditLog[]

  @@map("tenants")
}

model User {
  id           String    @id @default(uuid())
  tenantId     String
  name         String
  email        String
  passwordHash String    @map("password_hash")
  role         Role      @default(COMPANY_ADMIN)
  phoneNumber  String?   @map("phone_number")
  walletBalance Decimal  @default(0) @map("wallet_balance")
  referralCode String?   @unique @map("referral_code")
  referredById String?   @map("referred_by_id")
  badges       String[]  @default([])
  totalTrips   Int       @default(0) @map("total_trips")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id])
  referredBy User? @relation("Referrer", fields: [referredById], references: [id])
  referrals  User[] @relation("Referrer")

  driverTrips        Trip[]     @relation("PrimaryDriver")
  assistantDriverTrips Trip[]    @relation("AssistantDriver")
  hostessTrips       Trip[]     @relation("Hostess")
  bookings           Booking[]
  auditLogs          AuditLog[]
  priceAlerts        PriceAlert[]
  walletTransactions WalletTransaction[]

  @@unique([tenantId, email])
  @@map("users")
}

model Station {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  city        String
  locationLat Decimal? @map("location_lat")
  locationLng Decimal? @map("location_lng")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  originRoutes      Route[]     @relation("OriginStation")
  destinationRoutes Route[]     @relation("DestinationStation")
  routeStops        RouteStop[]

  @@map("stations")
}

model Vehicle {
  id                String        @id @default(uuid())
  tenantId          String
  make              String?
  model             String?
  year              Int?
  registrationPlate String        @unique @map("registration_plate")
  chassisNumber     String?       @map("chassis_number")
  engineNumber      String?       @map("engine_number")
  muayeneTarihi     DateTime?     @map("muayene_tarihi")
  sigortaTarihi     DateTime?     @map("sigorta_tarihi")
  currentMileage    Int           @default(0) @map("current_mileage")
  capacity          Int
  layoutType        String        @default("2+1") @map("layout_type")
  status            VehicleStatus @default(ACTIVE)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id])
  trips  Trip[]
  seats  Seat[]
  maintenanceRecords MaintenanceRecord[]
  fuelLogs           FuelLog[]

  @@map("vehicles")
}

model MaintenanceRecord {
  id            String    @id @default(uuid())
  vehicleId     String    @map("vehicle_id")
  type          String    // OIL_CHANGE, TIRE, BRAKE, INSPECTION, INSURANCE, CLEANING, REPAIR, OTHER
  description   String?
  cost          Decimal?
  odometerAt    Int?      @map("odometer_at")
  performedAt   DateTime  @map("performed_at")
  performedBy   String?   @map("performed_by")
  nextDueAt     DateTime? @map("next_due_at")
  nextDueKm     Int?      @map("next_due_km")
  attachmentUrl String?   @map("attachment_url")
  createdBy     String?   @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId, performedAt])
  @@map("maintenance_records")
}

model FuelLog {
  id         String   @id @default(uuid())
  vehicleId  String   @map("vehicle_id")
  tripId     String?  @map("trip_id")
  liters     Decimal
  pricePerL  Decimal  @map("price_per_l")
  totalCost  Decimal  @map("total_cost")
  odometerAt Int      @map("odometer_at")
  station    String?
  fueledAt   DateTime @map("fueled_at")
  fueledBy   String?  @map("fueled_by")
  createdAt  DateTime @default(now()) @map("created_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId, fueledAt])
  @@map("fuel_logs")
}

model Seat {
  id          String     @id @default(uuid())
  vehicleId   String
  seatNumber  Int        @map("seat_number")
  type        SeatType   @default(STANDARD)
  status      SeatStatus @default(AVAILABLE)
  lockedUntil DateTime?  @map("locked_until")
  lockedBy    String?    @map("locked_by")

  vehicle  Vehicle   @relation(fields: [vehicleId], references: [id])
  bookings Booking[]

  @@unique([vehicleId, seatNumber])
  @@map("seats")
}

model Route {
  id                 String   @id @default(uuid())
  tenantId           String
  title              String
  originStationId    String   @map("origin_station_id")
  destinationStationId String @map("destination_station_id")
  totalDistanceKm    Float    @map("total_distance_km")
  basePrice          Decimal  @map("base_price")
  taxRate            Decimal  @map("tax_rate")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant             Tenant      @relation(fields: [tenantId], references: [id])
  originStation      Station     @relation("OriginStation", fields: [originStationId], references: [id])
  destinationStation Station     @relation("DestinationStation", fields: [destinationStationId], references: [id])
  trips              Trip[]
  stops              RouteStop[]

  @@map("routes")
}

model RouteStop {
  id                        String   @id @default(uuid())
  routeId                   String   @map("route_id")
  stationId                 String   @map("station_id")
  stopOrder                 Int      @map("stop_order")
  arrivalTimeOffsetMinutes  Int      @default(0) @map("arrival_time_offset_minutes")

  route   Route   @relation(fields: [routeId], references: [id])
  station Station @relation(fields: [stationId], references: [id])

  @@unique([routeId, stopOrder])
  @@map("route_stops")
}

model Trip {
  id                String     @id @default(uuid())
  tenantId          String
  routeId           String
  vehicleId         String
  driverId          String
  assistantDriverId String?    @map("assistant_driver_id")
  hostessId         String?    @map("hostess_id")
  departureTime     DateTime   @map("departure_time")
  estimatedArrival  DateTime?  @map("estimated_arrival")
  actualArrival     DateTime?  @map("actual_arrival")
  status            TripStatus @default(PLANNED)
  notes             String?
  currentLat        Float?     @map("current_lat")
  currentLng        Float?     @map("current_lng")
  currentSpeed      Float?     @map("current_speed")
  lastLocationAt    DateTime?  @map("last_location_at")
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  route           Route    @relation(fields: [routeId], references: [id])
  vehicle         Vehicle  @relation(fields: [vehicleId], references: [id])
  driver          User     @relation("PrimaryDriver", fields: [driverId], references: [id])
  assistantDriver User?    @relation("AssistantDriver", fields: [assistantDriverId], references: [id])
  hostess         User?    @relation("Hostess", fields: [hostessId], references: [id])
  bookings        Booking[]

  @@map("trips")
}

model Booking {
  id              String        @id @default(uuid())
  tenantId        String
  tripId          String
  userId          String
  seatId          String
  passengerTcNo   String        @map("passenger_tc_no")
  passengerName   String        @map("passenger_name")
  contactEmail    String        @map("contact_email")
  contactPhone    String        @map("contact_phone")
  pricePaid       Decimal       @map("price_paid")
  bookingTime     DateTime      @default(now()) @map("booking_time")
  pnrCode         String        @unique @map("pnr_code")
  paymentId              String?       @map("payment_id")
  paymentTransactionId   String?       @map("payment_transaction_id")
  refundStatus           String?       @map("refund_status")
  refundedAt             DateTime?     @map("refunded_at")
  status          BookingStatus @default(CONFIRMED)
  boardingStatus  BoardingStatus @default(PENDING) @map("boarding_status")
  boardedAt       DateTime?      @map("boarded_at")
  boardedBy       String?        @map("boarded_by")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  trip   Trip   @relation(fields: [tripId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
  seat   Seat   @relation(fields: [seatId], references: [id])

  @@map("bookings")
}

model PendingPayment {
  id              String   @id @default(uuid())
  conversationId  String?  @map("conversation_id")
  paymentToken    String?  @unique @map("payment_token")
  tripId          String   @map("trip_id")
  passengersJson  String   @map("passengers_json")
  contactEmail    String   @map("contact_email")
  contactPhone    String   @map("contact_phone")
  price           String
  userId          String?  @map("user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("pending_payments")
}

model PriceAlert {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  originCity      String   @map("origin_city")
  destinationCity String   @map("destination_city")
  maxPrice        Decimal  @map("max_price")
  notifyEmail     Boolean  @default(true) @map("notify_email")
  notifySms       Boolean  @default(false) @map("notify_sms")
  active          Boolean  @default(true)
  lastNotifiedAt  DateTime? @map("last_notified_at")
  createdAt       DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, active])
  @@index([originCity, destinationCity, active])
  @@map("price_alerts")
}

model WalletTransaction {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  amount     Decimal
  type       String
  reason     String?
  bookingId  String?  @map("booking_id")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@map("wallet_transactions")
}

model PriceHistorySnapshot {
  id              String   @id @default(uuid())
  originCity      String   @map("origin_city")
  destinationCity String   @map("destination_city")
  minPrice        Decimal  @map("min_price")
  avgPrice        Decimal  @map("avg_price")
  maxPrice        Decimal  @map("max_price")
  tripCount       Int      @map("trip_count")
  snapshotDate    DateTime @map("snapshot_date")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([originCity, destinationCity, snapshotDate])
  @@map("price_history_snapshots")
}

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String
  userId     String?
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  timestamp  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User?  @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}
