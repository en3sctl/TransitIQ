// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  COMPANY_ADMIN
  OPERATOR
  DRIVER
  PASSENGER
}

enum VehicleStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

enum SeatType {
  STANDARD
  VIP
}

enum SeatStatus {
  AVAILABLE
  BLOCKED
  BOOKED
  LOCKED
}

enum TripStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  NO_SHOW
}

enum BoardingStatus {
  PENDING
  BOARDED
  NO_SHOW
}

model Tenant {
  id        String    @id @default(uuid())
  name      String    // legal / internal
  publicName String?  @map("public_name") // shown to passengers (e.g. "Metro Turizm")
  domain    String?   @unique
  slug      String    @unique
  status    String    @default("ACTIVE") // ACTIVE, PENDING, SUSPENDED

  // Branding
  logoUrl    String?  @map("logo_url")
  brandColor String?  @map("brand_color") // hex, e.g. "#4f46e5"
  aboutShort String?  @map("about_short") @db.VarChar(240)
  aboutLong  String?  @map("about_long")

  // Contact
  supportEmail String? @map("support_email")
  supportPhone String? @map("support_phone")
  website      String?
  address      String?

  // Verification / TR legal fields
  taxId        String?   @map("tax_id")
  mersisNo     String?   @map("mersis_no")
  uetdsLicense String?   @map("uetds_license") // D1/D2/D4 belge no
  verifiedAt   DateTime? @map("verified_at")

  // Payment — per-tenant Iyzico credentials (fallback: platform keys in .env)
  iyzicoMode      String  @default("PLATFORM") @map("iyzico_mode") // PLATFORM | OWN
  iyzicoApiKey    String? @map("iyzico_api_key")
  iyzicoSecretKey String? @map("iyzico_secret_key")

  // Commission rate platform keeps on each booking (0.0–1.0). 0 = no cut.
  commissionRate Decimal @default(0.08) @map("commission_rate") @db.Decimal(5, 4)

  // Subscription plan (tier-based pricing)
  planId String? @map("plan_id")

  // Risk score (0-100, higher = riskier). Computed by background job.
  riskScore Int @default(0) @map("risk_score")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  users       User[]
  vehicles    Vehicle[]
  stations    Station[]
  routes      Route[]
  trips       Trip[]
  bookings    Booking[]
  auditLogs   AuditLog[]
  settlements Settlement[]
  notes       TenantNote[]
  tags        TenantTag[]
  invoices    Invoice[]
  apiKeys     ApiKey[]
  plan        SubscriptionPlan? @relation(fields: [planId], references: [id])

  @@map("tenants")
}

/**
 * Platform-wide broadcast banner. Shown to the configured audience until
 * endsAt elapses. Created by SUPER_ADMIN only.
 */
model Announcement {
  id        String    @id @default(uuid())
  title     String
  body      String
  audience  String    @default("ALL") // ALL | COMPANY_ADMINS | PASSENGERS | DRIVERS
  severity  String    @default("INFO") // INFO | WARNING | CRITICAL
  linkUrl   String?   @map("link_url")
  linkLabel String?   @map("link_label")
  startsAt  DateTime  @default(now()) @map("starts_at")
  endsAt    DateTime? @map("ends_at")
  active    Boolean   @default(true)
  createdBy String    @map("created_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([active, startsAt, endsAt])
  @@map("announcements")
}

model Settlement {
  id               String    @id @default(uuid())
  tenantId         String    @map("tenant_id")
  bookingId        String    @unique @map("booking_id")
  grossAmount      Decimal   @map("gross_amount") @db.Decimal(10, 2)
  commissionAmount Decimal   @map("commission_amount") @db.Decimal(10, 2)
  netAmount        Decimal   @map("net_amount") @db.Decimal(10, 2)
  commissionRate   Decimal   @map("commission_rate") @db.Decimal(5, 4)
  status           String    @default("PENDING") // PENDING, SETTLED, REVERSED
  settledAt        DateTime? @map("settled_at")
  notes            String?
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([tenantId, status, createdAt])
  @@map("settlements")
}

model User {
  id           String    @id @default(uuid())
  tenantId     String
  name         String
  email        String
  passwordHash String    @map("password_hash")
  role         Role      @default(COMPANY_ADMIN)
  phoneNumber  String?   @map("phone_number")
  walletBalance Decimal  @default(0) @map("wallet_balance")
  referralCode String?   @unique @map("referral_code")
  referredById String?   @map("referred_by_id")
  badges       String[]  @default([])
  totalTrips   Int       @default(0) @map("total_trips")
  emailVerifiedAt DateTime? @map("email_verified_at")
  googleId     String?   @unique @map("google_id")
  avatarUrl    String?   @map("avatar_url")
  suspendedAt  DateTime? @map("suspended_at")
  suspendedReason String? @map("suspended_reason")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id])
  referredBy User? @relation("Referrer", fields: [referredById], references: [id])
  referrals  User[] @relation("Referrer")

  driverTrips        Trip[]     @relation("PrimaryDriver")
  assistantDriverTrips Trip[]    @relation("AssistantDriver")
  hostessTrips       Trip[]     @relation("Hostess")
  bookings           Booking[]
  auditLogs          AuditLog[]
  priceAlerts        PriceAlert[]
  walletTransactions WalletTransaction[]
  twoFactor          TwoFactorSecret?
  sessions           UserSession[]
  driverProfile      DriverProfile?
  driverDocuments    DriverDocument[]

  @@unique([tenantId, email])
  @@map("users")
}

/**
 * Şoföre özel genişletilmiş profil bilgileri. Sadece DRIVER rolündeki
 * user'lar için doldurulur; diğer roller için null kalır (opsiyonel ilişki).
 */
model DriverProfile {
  userId          String    @id @map("user_id")
  tenantId        String    @map("tenant_id")
  dateOfBirth     DateTime? @map("date_of_birth")
  bloodType       String?   @map("blood_type")
  emergencyContactName  String? @map("emergency_contact_name")
  emergencyContactPhone String? @map("emergency_contact_phone")
  emergencyContactRelation String? @map("emergency_contact_relation")
  address         String?
  city            String?
  shirtSize       String?   @map("shirt_size")
  notes           String?   // admin notları (HR vb.)
  // Tercihler
  language        String    @default("tr")
  notifyEmail     Boolean   @default(true) @map("notify_email")
  notifySms       Boolean   @default(false) @map("notify_sms")
  notifyPush      Boolean   @default(true) @map("notify_push")
  // İstatistik cache (periyodik güncellenir, read-heavy)
  totalTripsCompleted Int   @default(0) @map("total_trips_completed")
  totalDistanceKm     Int   @default(0) @map("total_distance_km")
  averageRating       Decimal? @db.Decimal(3, 2) @map("average_rating")
  reviewCount         Int   @default(0) @map("review_count")
  lastActiveAt        DateTime? @map("last_active_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("driver_profiles")
}

/**
 * Şoför belgeleri — ehliyet, SRC1-2-3-4, psikoteknik, sağlık raporu, adli sicil.
 * Her belge için numara + veriliş + bitiş. Cron yaklaşan süreleri admin'e bildirir.
 */
model DriverDocument {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  tenantId      String    @map("tenant_id")
  type          String    // LICENSE, SRC1, SRC2, SRC3, SRC4, PSYCHOTECH, HEALTH_REPORT, CRIMINAL_RECORD
  documentNumber String?  @map("document_number")
  licenseClass  String?   @map("license_class") // B, C, D, D1, E (ehliyet için)
  issuedAt      DateTime? @map("issued_at")
  validUntil    DateTime? @map("valid_until")
  imageUrl      String?   @map("image_url")
  note          String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([tenantId, type, validUntil])
  @@map("driver_documents")
}

model Station {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  city        String
  locationLat Decimal? @map("location_lat")
  locationLng Decimal? @map("location_lng")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  originRoutes      Route[]     @relation("OriginStation")
  destinationRoutes Route[]     @relation("DestinationStation")
  routeStops        RouteStop[]

  @@map("stations")
}

model Vehicle {
  id                String        @id @default(uuid())
  tenantId          String
  make              String?
  model             String?
  year              Int?
  registrationPlate String        @unique @map("registration_plate")
  chassisNumber     String?       @map("chassis_number")
  engineNumber      String?       @map("engine_number")
  muayeneTarihi     DateTime?     @map("muayene_tarihi")
  sigortaTarihi     DateTime?     @map("sigorta_tarihi")
  currentMileage    Int           @default(0) @map("current_mileage")
  capacity          Int
  layoutType        String        @default("2+1") @map("layout_type")
  status            VehicleStatus @default(ACTIVE)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id])
  trips  Trip[]
  seats  Seat[]
  maintenanceRecords MaintenanceRecord[]
  fuelLogs           FuelLog[]

  @@map("vehicles")
}

model MaintenanceRecord {
  id            String    @id @default(uuid())
  vehicleId     String    @map("vehicle_id")
  type          String    // OIL_CHANGE, TIRE, BRAKE, INSPECTION, INSURANCE, CLEANING, REPAIR, OTHER
  description   String?
  cost          Decimal?
  odometerAt    Int?      @map("odometer_at")
  performedAt   DateTime  @map("performed_at")
  performedBy   String?   @map("performed_by")
  nextDueAt     DateTime? @map("next_due_at")
  nextDueKm     Int?      @map("next_due_km")
  attachmentUrl String?   @map("attachment_url")
  createdBy     String?   @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId, performedAt])
  @@map("maintenance_records")
}

model FuelLog {
  id         String   @id @default(uuid())
  vehicleId  String   @map("vehicle_id")
  tripId     String?  @map("trip_id")
  liters     Decimal
  pricePerL  Decimal  @map("price_per_l")
  totalCost  Decimal  @map("total_cost")
  odometerAt Int      @map("odometer_at")
  station    String?
  fueledAt   DateTime @map("fueled_at")
  fueledBy   String?  @map("fueled_by")
  createdAt  DateTime @default(now()) @map("created_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId, fueledAt])
  @@map("fuel_logs")
}

model Seat {
  id          String     @id @default(uuid())
  vehicleId   String
  seatNumber  Int        @map("seat_number")
  type        SeatType   @default(STANDARD)
  status      SeatStatus @default(AVAILABLE)
  lockedUntil DateTime?  @map("locked_until")
  lockedBy    String?    @map("locked_by")

  vehicle  Vehicle   @relation(fields: [vehicleId], references: [id])
  bookings Booking[]

  @@unique([vehicleId, seatNumber])
  @@map("seats")
}

model Route {
  id                 String   @id @default(uuid())
  tenantId           String
  title              String
  originStationId    String   @map("origin_station_id")
  destinationStationId String @map("destination_station_id")
  totalDistanceKm    Float    @map("total_distance_km")
  basePrice          Decimal  @map("base_price")
  taxRate            Decimal  @map("tax_rate")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant             Tenant      @relation(fields: [tenantId], references: [id])
  originStation      Station     @relation("OriginStation", fields: [originStationId], references: [id])
  destinationStation Station     @relation("DestinationStation", fields: [destinationStationId], references: [id])
  trips              Trip[]
  stops              RouteStop[]

  @@map("routes")
}

model RouteStop {
  id                        String   @id @default(uuid())
  routeId                   String   @map("route_id")
  stationId                 String   @map("station_id")
  stopOrder                 Int      @map("stop_order")
  arrivalTimeOffsetMinutes  Int      @default(0) @map("arrival_time_offset_minutes")

  route   Route   @relation(fields: [routeId], references: [id])
  station Station @relation(fields: [stationId], references: [id])

  @@unique([routeId, stopOrder])
  @@map("route_stops")
}

model Trip {
  id                String     @id @default(uuid())
  tenantId          String
  routeId           String
  vehicleId         String
  driverId          String
  assistantDriverId String?    @map("assistant_driver_id")
  hostessId         String?    @map("hostess_id")
  departureTime     DateTime   @map("departure_time")
  estimatedArrival  DateTime?  @map("estimated_arrival")
  actualArrival     DateTime?  @map("actual_arrival")
  status            TripStatus @default(PLANNED)
  notes             String?
  currentLat        Float?     @map("current_lat")
  currentLng        Float?     @map("current_lng")
  currentSpeed      Float?     @map("current_speed")
  lastLocationAt    DateTime?  @map("last_location_at")
  // Vardiya takibi
  driverStartedAt   DateTime?  @map("driver_started_at")
  driverCompletedAt DateTime?  @map("driver_completed_at")
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  route           Route    @relation(fields: [routeId], references: [id])
  vehicle         Vehicle  @relation(fields: [vehicleId], references: [id])
  driver          User     @relation("PrimaryDriver", fields: [driverId], references: [id])
  assistantDriver User?    @relation("AssistantDriver", fields: [assistantDriverId], references: [id])
  hostess         User?    @relation("Hostess", fields: [hostessId], references: [id])
  bookings        Booking[]
  preTripCheck    PreTripCheck?
  driverExpenses  DriverExpense[]

  @@map("trips")
}

/**
 * Sefer öncesi araç kontrol formu — şoför seferi başlatmadan doldurur.
 * Sigorta/hukuki belge, bakım/kaza sonrası hakem için referans.
 */
model PreTripCheck {
  id                  String   @id @default(uuid())
  tripId              String   @unique @map("trip_id")
  driverId            String   @map("driver_id")
  // Temel kontroller (tüm Boolean)
  fuelOk              Boolean  @map("fuel_ok")
  tiresOk             Boolean  @map("tires_ok")
  brakesOk            Boolean  @map("brakes_ok")
  lightsOk            Boolean  @map("lights_ok")
  hornOk              Boolean  @map("horn_ok")
  wipersOk            Boolean  @map("wipers_ok")
  mirrorsOk           Boolean  @map("mirrors_ok")
  seatbeltsOk         Boolean  @map("seatbelts_ok")
  acOk                Boolean  @map("ac_ok")
  cleanInside         Boolean  @map("clean_inside")
  extinguisherOk      Boolean  @map("extinguisher_ok")  // yangın söndürücü
  firstAidOk          Boolean  @map("first_aid_ok")     // ilk yardım çantası
  emergencyHammerOk   Boolean  @map("emergency_hammer_ok")
  // Metrikler
  odometerKm          Int?     @map("odometer_km")
  fuelLevelPercent    Int?     @map("fuel_level_percent")
  issueNote           String?  @map("issue_note")  // eksik varsa açıklama
  hasIssue            Boolean  @default(false) @map("has_issue")
  createdAt           DateTime @default(now()) @map("created_at")

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([driverId, createdAt])
  @@map("pre_trip_checks")
}

/**
 * Dijital belge cüzdanı paylaşım tokenı — şoför QR oluşturur,
 * trafik polisi/denetim tarar, belgeleri tokenla okur.
 * 1 saat geçerli, tek kullanımlık değil (polis birkaç kere bakabilir).
 * Revoke edilebilir (yanlışlıkla paylaşıldıysa).
 */
model DriverWalletToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique  // random 32-char
  expiresAt DateTime @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("driver_wallet_tokens")
}

/**
 * Peer yol durumu — şoförler arası Waze-tarzı uyarı sistemi.
 * Bir şoför "Bolu'da sis" gibi alert yayınlar, 50 km civarındaki diğer
 * şoförler son 2 saatin alert'lerini görür. Upvote ile güven skoru artar.
 * Tenant-agnostic: tüm firmalardan şoförler birbirinin alert'ini görür.
 */
model RoadAlert {
  id          String   @id @default(uuid())
  reporterId  String   @map("reporter_id")  // User.id (DRIVER)
  reporterTenantId String @map("reporter_tenant_id")
  category    String   // TRAFFIC, ACCIDENT, POLICE, WEATHER, ROAD_WORK, HAZARD
  note        String?
  lat         Float
  lng         Float
  upvoteCount Int      @default(0) @map("upvote_count")
  downvoteCount Int    @default(0) @map("downvote_count")
  verifiedCount Int    @default(0) @map("verified_count") // bana da göründü diyen
  expiresAt   DateTime @map("expires_at")  // 2 saat sonra auto-expire
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([expiresAt, createdAt])
  @@index([lat, lng])
  @@map("road_alerts")
}

/**
 * Kayıp eşya yönetimi — yolcu sefer sonrası "otobüsümde X unuttum" bildirir,
 * şoför aktif seferinde görüp işaretler. Admin de moderate eder.
 */
model LostItem {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  tripId          String?   @map("trip_id")
  bookingId       String?   @map("booking_id")  // eşya bildiren yolcunun PNR'ı
  reporterUserId  String?   @map("reporter_user_id")  // auth kullanıcıysa
  reporterName    String    @map("reporter_name")
  reporterPhone   String?   @map("reporter_phone")
  itemDescription String    @map("item_description")
  seatNumber      Int?      @map("seat_number")
  imageUrl        String?   @map("image_url")
  status          String    @default("REPORTED")  // REPORTED, FOUND, NOT_FOUND, CLAIMED
  driverNote      String?   @map("driver_note")
  resolutionNote  String?   @map("resolution_note")
  resolvedAt      DateTime? @map("resolved_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([tenantId, status, createdAt])
  @@index([tripId])
  @@map("lost_items")
}

/**
 * SOS olayları ve pre-trip eksiklerinin admin çözüm takibi.
 * referenceType: "SOS" (AuditLog.id) veya "PRE_TRIP" (PreTripCheck.id).
 * Unique constraint — aynı olay iki kere resolve edilemez.
 */
model IncidentResolution {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  referenceType  String   @map("reference_type")  // SOS, PRE_TRIP
  referenceId    String   @map("reference_id")
  status         String   @default("ACKNOWLEDGED") // ACKNOWLEDGED, RESOLVED, FALSE_ALARM
  resolvedBy     String   @map("resolved_by")
  resolutionNote String   @map("resolution_note")
  resolvedAt     DateTime @default(now()) @map("resolved_at")

  @@unique([referenceType, referenceId])
  @@index([tenantId, resolvedAt])
  @@map("incident_resolutions")
}

/**
 * Şoförün sefer sırasında girdiği masraflar: yakıt, otoyol, yemek, mola, otopark.
 * Makbuz URL opsiyonel (ileride upload eklenince). Admin tarafında onaylanır/reddedilir.
 */
model DriverExpense {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  tripId      String   @map("trip_id")
  driverId    String   @map("driver_id")
  category    String   // FUEL, TOLL, FOOD, PARKING, OTHER
  amount      Decimal  @db.Decimal(10, 2)
  description String?
  receiptUrl  String?  @map("receipt_url")
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED
  reviewedBy  String?  @map("reviewed_by")
  reviewedAt  DateTime? @map("reviewed_at")
  reviewNote  String?  @map("review_note")
  createdAt   DateTime @default(now()) @map("created_at")

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, createdAt])
  @@index([driverId, createdAt])
  @@map("driver_expenses")
}

model Booking {
  id              String        @id @default(uuid())
  tenantId        String
  tripId          String
  userId          String
  seatId          String
  passengerTcNo   String        @map("passenger_tc_no")
  passengerName   String        @map("passenger_name")
  contactEmail    String        @map("contact_email")
  contactPhone    String        @map("contact_phone")
  pricePaid       Decimal       @map("price_paid")
  bookingTime     DateTime      @default(now()) @map("booking_time")
  pnrCode         String        @unique @map("pnr_code")
  paymentId              String?       @map("payment_id")
  paymentTransactionId   String?       @map("payment_transaction_id")
  refundStatus           String?       @map("refund_status")
  refundedAt             DateTime?     @map("refunded_at")
  status          BookingStatus @default(CONFIRMED)
  boardingStatus  BoardingStatus @default(PENDING) @map("boarding_status")
  boardedAt       DateTime?      @map("boarded_at")
  boardedBy       String?        @map("boarded_by")
  reminderSentAt  DateTime?      @map("reminder_sent_at")

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  trip       Trip        @relation(fields: [tripId], references: [id])
  user       User        @relation(fields: [userId], references: [id])
  seat       Seat        @relation(fields: [seatId], references: [id])
  settlement Settlement?
  reviews    Review[]

  @@map("bookings")
}

model PendingPayment {
  id              String   @id @default(uuid())
  conversationId  String?  @map("conversation_id")
  paymentToken    String?  @unique @map("payment_token")
  tripId          String   @map("trip_id")
  passengersJson  String   @map("passengers_json")
  contactEmail    String   @map("contact_email")
  contactPhone    String   @map("contact_phone")
  price           String
  userId          String?  @map("user_id")
  walletAmount    Decimal? @map("wallet_amount")
  promoCodeId     String?  @map("promo_code_id")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("pending_payments")
}

model PriceAlert {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  originCity      String   @map("origin_city")
  destinationCity String   @map("destination_city")
  maxPrice        Decimal  @map("max_price")
  notifyEmail     Boolean  @default(true) @map("notify_email")
  notifySms       Boolean  @default(false) @map("notify_sms")
  active          Boolean  @default(true)
  lastNotifiedAt  DateTime? @map("last_notified_at")
  createdAt       DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, active])
  @@index([originCity, destinationCity, active])
  @@map("price_alerts")
}

model WalletTransaction {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  amount     Decimal
  type       String
  reason     String?
  bookingId  String?  @map("booking_id")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@map("wallet_transactions")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  verifiedAt DateTime? @map("verified_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("email_verification_tokens")
}

model PriceHistorySnapshot {
  id              String   @id @default(uuid())
  originCity      String   @map("origin_city")
  destinationCity String   @map("destination_city")
  minPrice        Decimal  @map("min_price")
  avgPrice        Decimal  @map("avg_price")
  maxPrice        Decimal  @map("max_price")
  tripCount       Int      @map("trip_count")
  snapshotDate    DateTime @map("snapshot_date")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([originCity, destinationCity, snapshotDate])
  @@map("price_history_snapshots")
}

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String
  userId     String?
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  timestamp  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User?  @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model PromoCode {
  id               String   @id @default(uuid())
  tenantId         String?  @map("tenant_id") // null = platform-wide
  code             String   @unique
  discountType     String   @map("discount_type") // PERCENT | FIXED
  discountValue    Decimal  @map("discount_value")
  minBookingAmount Decimal? @map("min_booking_amount")
  maxUses          Int?     @map("max_uses")
  usedCount        Int      @default(0) @map("used_count")
  validFrom        DateTime @map("valid_from")
  validUntil       DateTime @map("valid_until")
  active           Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at")

  applications PromoCodeApplication[]

  @@index([code])
  @@map("promo_codes")
}

model PromoCodeApplication {
  id              String   @id @default(uuid())
  promoCodeId     String   @map("promo_code_id")
  bookingId       String   @map("booking_id")
  userId          String   @map("user_id")
  discountApplied Decimal  @map("discount_applied")
  appliedAt       DateTime @default(now()) @map("applied_at")

  promoCode PromoCode @relation(fields: [promoCodeId], references: [id])

  @@map("promo_code_applications")
}

model Review {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  bookingId String   @unique @map("booking_id")
  userId    String   @map("user_id")
  tripId    String   @map("trip_id")
  driverId  String?  @map("driver_id")
  rating    Int      // 1-5
  comment   String?
  tags      String[] @default([])  // CLEAN, ON_TIME, FRIENDLY, COMFORTABLE, RUDE, LATE, DIRTY
  hidden    Boolean  @default(false)  // admin can hide inappropriate reviews
  createdAt DateTime @default(now()) @map("created_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tripId])
  @@index([driverId])
  @@map("reviews")
}

model Complaint {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  userId      String?   @map("user_id")  // null = guest complaint
  bookingId   String?   @map("booking_id")
  contactEmail String   @map("contact_email")
  contactName String    @map("contact_name")
  category    String    // DELAY, DRIVER, CLEANLINESS, PAYMENT, SEAT, OTHER
  subject     String
  description String
  status      String    @default("OPEN")  // OPEN, IN_PROGRESS, RESOLVED, DISMISSED
  priority    String    @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  assignedTo  String?   @map("assigned_to")
  resolution  String?
  createdAt   DateTime  @default(now()) @map("created_at")
  resolvedAt  DateTime? @map("resolved_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([tenantId, status, createdAt])
  @@index([bookingId])
  @@map("complaints")
}

model WaitingListEntry {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  tripId         String    @map("trip_id")
  userId         String?   @map("user_id")  // null = guest entry
  contactName    String    @map("contact_name")
  contactEmail   String    @map("contact_email")
  contactPhone   String?   @map("contact_phone")
  passengerCount Int       @default(1) @map("passenger_count")
  status         String    @default("WAITING")  // WAITING, NOTIFIED, CONVERTED, EXPIRED, CANCELLED
  notifiedAt     DateTime? @map("notified_at")
  notifyCount    Int       @default(0) @map("notify_count")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([tripId, status, createdAt])
  @@index([tenantId, status])
  @@index([userId])
  @@map("waiting_list")
}

// ════════════════════════════════════════════════════════════════
// Platform operator models (SUPER_ADMIN / enterprise)
// ════════════════════════════════════════════════════════════════

/** Singleton key-value store for platform-wide configuration. */
model PlatformSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  type      String   @default("string") // string | number | boolean | json
  updatedAt DateTime @updatedAt
  updatedBy String?  @map("updated_by")
  @@map("platform_settings")
}

/** Dahili firma notları — super-admin'in müşteri ilişkileri CRM'i. */
model TenantNote {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  authorId  String   @map("author_id")
  body      String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, pinned, createdAt])
  @@map("tenant_notes")
}

model TenantTag {
  id       String  @id @default(uuid())
  tenantId String  @map("tenant_id")
  label    String
  color    String?

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, label])
  @@map("tenant_tags")
}

/** KVKK/GDPR veri talebi (indirme, silme, düzeltme). Yasal zorunluluk. */
model DataRequest {
  id           String    @id @default(uuid())
  userId       String?   @map("user_id")
  contactEmail String    @map("contact_email")
  contactName  String    @map("contact_name")
  type         String    // EXPORT | DELETE | CORRECT | RESTRICT
  status       String    @default("PENDING") // PENDING | IN_PROGRESS | COMPLETED | REJECTED
  reason       String?
  resolution   String?
  resolvedAt   DateTime? @map("resolved_at")
  handledBy    String?   @map("handled_by")
  dataUrl      String?   @map("data_url") // if EXPORT completed, link to generated JSON/PDF
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([contactEmail])
  @@map("data_requests")
}

model SubscriptionPlan {
  id                 String   @id @default(uuid())
  name               String   @unique
  slug               String   @unique
  description        String?
  monthlyFee         Decimal  @default(0) @map("monthly_fee") @db.Decimal(10, 2)
  commissionRate     Decimal  @map("commission_rate") @db.Decimal(5, 4)
  maxVehicles        Int?     @map("max_vehicles")
  maxRoutes          Int?     @map("max_routes")
  maxMonthlyBookings Int?     @map("max_monthly_bookings")
  features           String[] @default([])
  active             Boolean  @default(true)
  sortOrder          Int      @default(0) @map("sort_order")
  createdAt          DateTime @default(now())

  tenants Tenant[]

  @@map("subscription_plans")
}

model Invoice {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  invoiceNo       String    @unique @map("invoice_no")
  periodStart     DateTime  @map("period_start")
  periodEnd       DateTime  @map("period_end")
  subscriptionFee Decimal   @default(0) @map("subscription_fee") @db.Decimal(10, 2)
  commissionTotal Decimal   @map("commission_total") @db.Decimal(10, 2)
  bookingCount    Int       @map("booking_count")
  grossTotal      Decimal   @map("gross_total") @db.Decimal(10, 2)
  netToCompany    Decimal   @map("net_to_company") @db.Decimal(10, 2)
  taxRate         Decimal   @default(0.18) @map("tax_rate") @db.Decimal(5, 4)
  taxAmount       Decimal   @default(0) @map("tax_amount") @db.Decimal(10, 2)
  pdfUrl          String?   @map("pdf_url")
  status          String    @default("DRAFT") // DRAFT | ISSUED | SENT | PAID | OVERDUE | CANCELLED
  sentAt          DateTime? @map("sent_at")
  paidAt          DateTime? @map("paid_at")
  dueAt           DateTime? @map("due_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, status, periodEnd])
  @@map("invoices")
}

model TwoFactorSecret {
  id          String    @id @default(uuid())
  userId      String    @unique @map("user_id")
  secret      String    // base32 TOTP secret (encrypted at rest ideally)
  enabled     Boolean   @default(false)
  backupCodes String[]  @default([]) @map("backup_codes") // hashed
  enabledAt   DateTime? @map("enabled_at")
  lastUsedAt  DateTime? @map("last_used_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("two_factor_secrets")
}

model UserSession {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash") // SHA-256 of JWT
  userAgent  String?   @map("user_agent")
  ipAddress  String?   @map("ip_address")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([tokenHash])
  @@map("user_sessions")
}

model EmailTemplate {
  id        String   @id @default(uuid())
  key       String   @unique // BOOKING_CONFIRMATION | WELCOME | PASSWORD_RESET | etc.
  name      String
  subject   String
  bodyHtml  String   @map("body_html")
  variables Json?
  description String?
  updatedAt DateTime @updatedAt
  updatedBy String?  @map("updated_by")
  createdAt DateTime @default(now())
  @@map("email_templates")
}

model FeatureFlag {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String?
  enabled     Boolean  @default(false)
  audience    String   @default("ALL") // ALL | TENANT_IDS | PERCENTAGE
  rolloutPct  Int      @default(100)
  tenantIds   String[] @default([]) @map("tenant_ids")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@map("feature_flags")
}

model ApiKey {
  id         String    @id @default(uuid())
  tenantId   String    @map("tenant_id")
  name       String
  keyHash    String    @unique @map("key_hash")
  keyPrefix  String    @map("key_prefix") // "tiq_live_abc123..."
  scopes     String[]  @default([])
  lastUsedAt DateTime? @map("last_used_at")
  expiresAt  DateTime? @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdBy  String    @map("created_by")
  createdAt  DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, revokedAt])
  @@map("api_keys")
}

model Incident {
  id               String           @id @default(uuid())
  title            String
  description      String
  severity         String           @default("MAJOR") // MINOR | MAJOR | CRITICAL
  status           String           @default("INVESTIGATING") // INVESTIGATING | IDENTIFIED | MONITORING | RESOLVED
  affectedServices String[]         @default([]) @map("affected_services")
  publicMessage    String?          @map("public_message")
  startedAt        DateTime         @default(now()) @map("started_at")
  resolvedAt       DateTime?        @map("resolved_at")
  createdBy        String           @map("created_by")

  updates          IncidentUpdate[]

  @@index([status, startedAt])
  @@map("incidents")
}

model IncidentUpdate {
  id         String   @id @default(uuid())
  incidentId String   @map("incident_id")
  status     String
  message    String
  createdAt  DateTime @default(now()) @map("created_at")

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  @@map("incident_updates")
}

model SupportTicket {
  id           String           @id @default(uuid())
  tenantId     String?          @map("tenant_id")
  userId       String?          @map("user_id")
  contactEmail String           @map("contact_email")
  contactName  String           @map("contact_name")
  subject      String
  status       String           @default("OPEN") // OPEN | IN_PROGRESS | WAITING | RESOLVED | CLOSED
  priority     String           @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  category     String?
  assignedTo   String?          @map("assigned_to")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  messages SupportMessage[]

  @@index([status, priority, createdAt])
  @@map("support_tickets")
}

model SupportMessage {
  id         String   @id @default(uuid())
  ticketId   String   @map("ticket_id")
  authorId   String?  @map("author_id")
  authorName String   @map("author_name")
  body       String
  internal   Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("support_messages")
}

model TermsVersion {
  id          String   @id @default(uuid())
  version     String   @unique
  kind        String   @default("TERMS") // TERMS | PRIVACY | KVKK | COOKIE
  bodyHtml    String   @map("body_html")
  summary     String?
  publishedAt DateTime @default(now()) @map("published_at")
  current     Boolean  @default(false)

  @@index([kind, current])
  @@map("terms_versions")
}

model ConsentLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  email     String?
  kind      String // TERMS | KVKK | COOKIE_ANALYTICS | COOKIE_MARKETING | MARKETING_EMAIL
  version   String?
  granted   Boolean
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, kind])
  @@index([email, kind])
  @@map("consent_logs")
}
